# Required: Claude API key for the AI analysis
ANTHROPIC_API_KEY=sk-ant-...

# Fastmail auth — choose ONE style:

# (a) Single account
FASTMAIL_TOKEN=fmu1-...

# (b) Multiple accounts: name:token pairs, comma-separated
# FASTMAIL_ACCOUNTS=work:fmu1-aaa,personal:fmu1-bbb

# Optional: override the Claude model (default: claude-sonnet-4-6)
# FASTMAIL_TRIAGE_MODEL=claude-opus-4-8

# Optional: path to the engine binary if not on PATH
# FASTMAIL_CLI_BIN=/usr/local/bin/fastmail-cli
